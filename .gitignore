# Local .terraform directories (plugin binaries)
**/.terraform/*

# Terraform state files (sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable definition files containing secrets
*.tfvars
*.tfvars.json

# CLI configuration and execution plan files
*.tfplan
.terraformrc
terraform.rc

# Crash log files
crash.log
crash.*.log

# SSH keys and certificates
*.pem
*.key
*.pub
